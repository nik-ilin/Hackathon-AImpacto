# Judy · variables de entorno (solo servidor / GitHub Actions). Nunca en el frontend ni en variables VITE_.
SUPABASE_URL=https://<proyecto>.supabase.co
# Clave de servicio (sb_secret_... o service_role heredada). Solo para escribir convocatorias.
SUPABASE_SERVICE_ROLE_KEY=
# Firecrawl: motor de las webs de fundaciones sin API (scrape + extracción JSON en una llamada).
FIRECRAWL_API_KEY=
# FIRECRAWL_MAX_AGE_MS=86400000   # reutiliza la caché de Firecrawl hasta 24 h
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
# Alternativa sin Firecrawl: descarga directa + extracción con Claude.
ANTHROPIC_API_KEY=
JUDY_LLM_MODEL=
# Servidor HTTP para Make (npm run serve)
JUDY_API_KEY=
MAKE_CALLBACK_URL=
PORT=8787
# JUDY_USER_AGENT="NexoLab-Judy/0.1 (+contacto)"
