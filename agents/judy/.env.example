# Server-only / GitHub Actions configuration. Never VITE_ or browser values.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, explicit private_web source; external cost requires operator enablement.
FIRECRAWL_API_KEY=
# FIRECRAWL_MAX_AGE_MS=86400000
# Alternative private_web extraction provider (only when no Firecrawl key).
ANTHROPIC_API_KEY=
JUDY_LLM_MODEL=
# Optional trusted-host server; preferred strategy Actions dispatch/poll.
JUDY_API_KEY=
PORT=8787
# MAKE_CALLBACK_URL is deliberately unsupported; use authenticated polling.
# JUDY_USER_AGENT=NexoLab-Judy/0.1 (+contact)
