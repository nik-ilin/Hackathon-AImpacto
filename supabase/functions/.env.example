# Solo para `supabase functions serve --env-file supabase/functions/.env`.
# Copia este archivo a .env en la misma carpeta (ignorado por Git) y completa
# las credenciales públicas de cliente ORCID en tu entorno local.
# Nunca uses variables VITE para estos valores ni los incluyas en el frontend.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
